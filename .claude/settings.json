{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/npm.ps1 run build)",
      "PowerShell(powershell -NoProfile -ExecutionPolicy Bypass -File .specify/scripts/powershell/*)",
      "Bash(npm run build)",
      "Bash(specify integration status)",
      "Bash(specify integration list)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./.tools/**)",
      "Read(./node_modules/**)"
    ]
  }
}
