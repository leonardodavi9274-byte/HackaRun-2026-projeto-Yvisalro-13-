NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:5173
FRONTEND_ORIGIN=http://127.0.0.1:5173
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
# 32 bytes aleatórios em base64, somente no servidor.
APP_SECURITY_KEY=
# Destinos reais; não preencher com links fictícios.
TERMS_URL=
PRIVACY_URL=
AUTH_CONFIRMATION_TTL_SECONDS=3600
AUTH_RESEND_MIN_INTERVAL_SECONDS=60
# O SMTP, os modelos de e-mail, o OTP e os provedores sociais são configurados
# no Supabase Auth; os fluxos da feature 007 ainda dependem dos bloqueios do plano.
# Não inclua credenciais de SMTP, Google ou Apple neste arquivo de exemplo.
